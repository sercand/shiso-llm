/// Copies one table's raw bytes into a device buffer.
///
/// `args.table` selects the table in the order the arrays are declared above
/// (0 `IQ2XXS_GRID`, 1 `IQ2XS_GRID`, 2 `IQ2S_GRID`, 3 `IQ3XXS_GRID`,
/// 4 `IQ3S_GRID`, 5 `IQ1S_GRID`, 6 `IQ4NL`, 7 `KSIGNS_IQ2XS`, 8 `KSIGNS64`);
/// an index outside 0..8 writes nothing. The destination is a bound buffer
/// rather than a pointer inside the argument block, because a Metal buffer
/// carries no address the host could write into a struct.
///
/// The element widths differ across the nine tables, so the copy moves `ulong`
/// words instead: every table's byte length is a multiple of eight, and the
/// device is little-endian like the host, so the buffer ends up holding the
/// table's native-endian bytes with the elements in order. The grid is the
/// word count of the largest table (2048); threads past the selected table's
/// word count exit.
struct shs_metal_args_iq_table_copy {
    uint table;
};

kernel void kernel_iq_table_copy(
        constant shs_metal_args_iq_table_copy & args [[buffer(0)]],
        device uchar * dst [[buffer(1)]],
        uint gid [[thread_position_in_grid]]) {
    constant const ulong * src;
    ulong n_words;
    switch (args.table) {
        case 0: src = &IQ2XXS_GRID[0];   n_words = sizeof(IQ2XXS_GRID) / 8; break;
        case 1: src = &IQ2XS_GRID[0];    n_words = sizeof(IQ2XS_GRID) / 8; break;
        case 2: src = &IQ2S_GRID[0];     n_words = sizeof(IQ2S_GRID) / 8; break;
        case 3: src = (constant const ulong *) &IQ3XXS_GRID[0]; n_words = sizeof(IQ3XXS_GRID) / 8; break;
        case 4: src = (constant const ulong *) &IQ3S_GRID[0];   n_words = sizeof(IQ3S_GRID) / 8; break;
        case 5: src = &IQ1S_GRID[0];     n_words = sizeof(IQ1S_GRID) / 8; break;
        case 6: src = (constant const ulong *) &IQ4NL[0];       n_words = sizeof(IQ4NL) / 8; break;
        case 7: src = (constant const ulong *) &KSIGNS_IQ2XS[0]; n_words = sizeof(KSIGNS_IQ2XS) / 8; break;
        case 8: src = &KSIGNS64[0];      n_words = sizeof(KSIGNS64) / 8; break;
        default: return;
    }
    if (gid >= n_words) return;
    ((device ulong *) dst)[gid] = src[gid];
}
